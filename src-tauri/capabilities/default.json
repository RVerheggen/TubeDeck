{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "TubeDeck main window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "dialog:allow-open",
    "clipboard-manager:allow-write-text",
    "log:default"
  ]
}
