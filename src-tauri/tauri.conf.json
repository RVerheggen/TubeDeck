{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TubeDeck",
  "version": "0.1.5",
  "identifier": "com.tubedeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TubeDeck",
        "width": 1400,
        "height": 950,
        "minWidth": 850,
        "minHeight": 650,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: http://asset.localhost https:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "shortDescription": "A modern yt-dlp download manager",
    "longDescription": "TubeDeck is a Windows download manager for yt-dlp with a live queue, playlists, presets, history and one-click engine setup.",
    "publisher": "TubeDeck",
    "copyright": "© 2026 TubeDeck",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3MzQ4NkNBQkQyMDZFRkMKUldUOGJpQzl5b1kwUnh1VU5BLytCVzdFNGtzeEMvbEl6NzBFbHJ5S0xpMHpEUE9WZmtZRzF2VTIK",
      "endpoints": [
        "https://github.com/RVerheggen/TubeDeck/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
